# ==============================================================================
# KHAN CLOTHES WAREHOUSE - REACT NATIVE MOBILE APP GITIGNORE
# Protects private secrets, environment variables, certificates, keystores & builds
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (NEVER COMMIT TO GITHUB)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Firebase Secret / App Config Files
android/app/google-services.json
!android/app/google-services.json.example
ios/GoogleService-Info.plist
!ios/GoogleService-Info.plist.example

# Apple Developer & APNs Private Keys / Provisioning Profiles
*.p8
*.p12
*.cer
*.crt
*.pem
*.key
*.mobileprovision

# Android Release Keystores & Signing Keys (keep debug.keystore for local dev)
*.keystore
*.jks
!debug.keystore

# ------------------------------------------------------------------------------
# 2. OSX & Editor
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 3. Xcode / iOS Build Artifacts
# ------------------------------------------------------------------------------
ios/build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# ------------------------------------------------------------------------------
# 4. Android Build Artifacts & C++
# ------------------------------------------------------------------------------
android/app/build/
android/build/
android/.gradle/
android/local.properties
*.iml
*.hprof
android/.cxx/
android/app/.cxx/

# ------------------------------------------------------------------------------
# 5. Node.js & Dependencies
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. Fastlane
# ------------------------------------------------------------------------------
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# ------------------------------------------------------------------------------
# 7. Metro & Bundling Artifacts
# ------------------------------------------------------------------------------
*.jsbundle
.metro-health-check*

# ------------------------------------------------------------------------------
# 8. Ruby / CocoaPods
# ------------------------------------------------------------------------------
ios/Pods/
**/Pods/
/vendor/bundle/

# ------------------------------------------------------------------------------
# 9. Testing & Coverage
# ------------------------------------------------------------------------------
coverage/

# ------------------------------------------------------------------------------
# 10. Yarn
# ------------------------------------------------------------------------------
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
