# ==============================================================================
# KHAN JACKET HOUSE - MOBILE APP ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual values.
# ==============================================================================

# Application Meta
APP_ENV=development
APP_NAME=Khan Jacket House
APP_VERSION=1.0.0
APP_BUNDLE_ID=com.warehouseapp

# ------------------------------------------------------------------------------
# Backend API Endpoints
# ------------------------------------------------------------------------------
# Android Emulator (Android Loopback IP)
API_BASE_URL=http://10.0.2.2:5000/api/v1

# iOS Simulator (Localhost)
API_IOS_URL=http://localhost:5000/api/v1

# Physical Device on Wi-Fi (Enter your PC LAN IP)
API_DEVICE_URL=http://192.168.1.100:5000/api/v1

# Production Live API (Live Domain)
# API_PRODUCTION_URL=https://api.yourdomain.com/api/v1

# ------------------------------------------------------------------------------
# Google Firebase Push Notification Keys
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PROJECT_NUMBER=your-project-number
FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
FIREBASE_APP_ID=1:your-project-number:android:your-app-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_MESSAGING_SENDER_ID=your-project-number

# ------------------------------------------------------------------------------
# Apple APNs Configuration
# ------------------------------------------------------------------------------
APPLE_BUNDLE_ID=com.warehouseapp
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_AUTH_KEY_P8_PATH=

